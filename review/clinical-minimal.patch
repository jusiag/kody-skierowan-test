diff --git a/tests/search-reference.cjs b/tests/search-reference.cjs
new file mode 100644
index 0000000..184556f
--- /dev/null
+++ b/tests/search-reference.cjs
@@ -0,0 +1,38 @@
+// Executes the actual production search functions in Node, without rewriting them.
+// Browser behavior is covered separately by browser.spec.cjs.
+const fs = require('node:fs');
+const vm = require('node:vm');
+const zlib = require('node:zlib');
+const path = require('node:path');
+const assert = require('node:assert/strict');
+const root = path.resolve(process.argv[2] || path.join(__dirname, '..'));
+const output = path.join(__dirname, 'search-baseline.json.gz');
+const queries = ['usg tarczycy','rtg klatki','kolano','rehabilitacja','93.11','88','1308','4308','4309','fizjoterapia kardiologiczna','a','tarczyca kolano','zzzzzzzz','usg','mr','mri','rm','tk','ct','ekg','eeg','emg','ktg','pet','88.7'];
+function run(dir) {
+  const data = JSON.parse(fs.readFileSync(path.join(dir,'data/icd9.json')));
+  const elements = new Map();
+  const element = () => ({textContent:'{}',value:'',hidden:false,innerHTML:'',getAttribute:()=> 'false',addEventListener(){}});
+  const context = {window:{},document:{getElementById(id){if(!elements.has(id))elements.set(id,element());return elements.get(id)},addEventListener(){}},localStorage:{getItem(){return null}},location:{href:'https://example.test/kody-skierowan/'},URL,setTimeout,clearTimeout,console,DATA_INPUT:data};
+  vm.createContext(context);
+  vm.runInContext(fs.readFileSync(path.join(dir,'resort.js'),'utf8'),context);
+  let source=fs.readFileSync(path.join(dir,'app.js'),'utf8');
+  // Strip UI side effects inside load, but retain index construction verbatim.
+  const begin=source.indexOf('    $("verChip").textContent');
+  const end=source.indexOf('\n  const JOINTS',begin);
+  source=source.slice(0,begin)+'  }\n'+source.slice(end);
+  source=source.replace('  boot();','  load(DATA_INPUT); window.testAPI = {search, resSearch, highlight};');
+  vm.runInContext(source,context);
+  return Object.fromEntries(queries.map(q=>{
+    const result=q.trim().length===1?{short:true}:context.window.testAPI.search(q);
+    return [q,JSON.parse(JSON.stringify({result,resort:context.window.testAPI.resSearch(q)}))];
+  }));
+}
+const actual=run(root);
+if(process.argv.includes('--record')){
+  assert(!fs.existsSync(output),'Baseline already exists; do not overwrite reference.');
+  fs.writeFileSync(output,zlib.gzipSync(JSON.stringify(actual))); 
+  console.log('Recorded',queries.length,'queries from',root);
+}else{
+  assert.deepEqual(actual,JSON.parse(zlib.gunzipSync(fs.readFileSync(output))), 'Search results/order/context differ from baseline');
+  console.log('PASS:',queries.length,'queries: complete results, order, hierarchy, resort codes');
+}
diff --git a/tests/ui-unit.cjs b/tests/ui-unit.cjs
new file mode 100644
index 0000000..858d227
--- /dev/null
+++ b/tests/ui-unit.cjs
@@ -0,0 +1,62 @@
+// Presentation logic with small DOM doubles. These are NOT browser/layout tests.
+const fs=require('node:fs'),vm=require('node:vm'),assert=require('node:assert/strict'),path=require('node:path');
+const root=path.resolve(__dirname,'..');
+const data=JSON.parse(fs.readFileSync(path.join(root,'data/icd9.json')));
+const elements=new Map(),classes=new Set(),clicks=[],storage=new Map();
+const make=()=>({textContent:'',innerHTML:'',value:'',hidden:false,attrs:{},classList:{add(){},remove(){}},getAttribute(k){return this.attrs[k]||'false'},setAttribute(k,v){this.attrs[k]=String(v)},addEventListener(){}});
+const get=id=>{if(!elements.has(id))elements.set(id,make());return elements.get(id)};
+get('nfzmeta').textContent='{}';
+let selection,clipboard,copySuccess=true,clipboardReject=false;
+const ctx={window:{},document:{getElementById:get,addEventListener(type,fn){if(type==='click')clicks.push(fn)},createRange(){return {selectNodeContents(node){selection=node.textContent}}},execCommand(){return copySuccess},createElement(){return {...make(),remove(){this.removed=true}}}},localStorage:{getItem(k){return storage.get(k)||null},setItem(k,v){storage.set(k,v)}},navigator:{onLine:true,clipboard:{async writeText(text){if(clipboardReject)throw Error('denied');clipboard=text}}},getSelection:()=>({removeAllRanges(){},addRange(){}}),requestAnimationFrame:fn=>fn(),setTimeout:()=>1,clearTimeout(){},location:{href:'https://example.test/kody-skierowan/'},URL,console,DATA_INPUT:data};
+vm.createContext(ctx);vm.runInContext(fs.readFileSync(path.join(root,'resort.js'),'utf8'),ctx);
+let source=fs.readFileSync(path.join(root,'app.js'),'utf8');
+const begin=source.indexOf('    $("verChip").textContent'),end=source.indexOf('\n  const JOINTS',begin);
+source=source.slice(0,begin)+'  }\n'+source.slice(end);
+source=source.replace('  boot();','  load(DATA_INPUT); window.testAPI={copy,rowHTML,resRow,render,updateInfo,updateNetworkStatus, setMeta(m){META=m;}, entry(c){return byCode.get(c);}};');
+vm.runInContext(source,ctx);const api=ctx.window.testAPI;
+let checks=0;const check=(name,fn)=>{fn();checks++;console.log('PASS',name)};
+(async()=>{
+  const btn={textContent:'88.713 copy',querySelector:()=>({textContent:'88.713'}),classList:{add(x){classes.add(x)},remove(x){classes.delete(x)}}};
+  await api.copy('88.713',btn);
+  check('Clipboard API gets only exact code',()=>{assert.equal(clipboard,'88.713');assert(classes.has('copied'));assert.equal(get('toast').textContent,'Skopiowano 88.713')});
+  clipboardReject=true;classes.clear();await api.copy('88.713',btn);
+  check('Fallback selects only code span',()=>{assert.equal(selection,'88.713');assert(classes.has('copied'))});
+  classes.clear();copySuccess=false;await api.copy('88.713',btn);
+  check('Copy failure does not show success state',()=>{assert(!classes.has('copied'));assert.match(get('toast').textContent,/ręcznie/)});
+  check('Row has accessible copy and contextual favorite',()=>{const html=api.rowHTML(api.entry('88.713'),['usg','tarczycy']);assert.match(html,/aria-label="Kopiuj kod 88.713"/);assert.match(html,/aria-label="Ulubione: 88.713 USG tarczycy i przytarczyc"/);assert.match(html,/<mark>USG<\/mark>/)});
+  for(const [q,label] of [['','start'],['a','minimum length'],['zzzzzzzz','empty'],['tarczyca kolano','partial'],['88','large list'],['4309','derived resort']]){
+    get('q').value=q;api.render();
+    check('Render '+label,()=>{if(!q){assert.equal(get('resWrap').hidden,true)}else if(q==='a'){assert.match(get('resTitle').textContent,/2 znaki/)}else if(q==='zzzzzzzz'){assert.match(get('results').innerHTML,/Nic nie znaleziono/)}else if(q==='88'){assert.equal((get('results').innerHTML.match(/data-code=/g)||[]).length,60);assert.match(get('results').innerHTML,/data-more/)}else if(q==='4309'){assert.match(get('resortOut').innerHTML,/data-copy="4309"/);assert.match(get('resortOut').innerHTML,/4308/);assert.match(get('resortOut').innerHTML,/To nie są kody procedur ICD-9/)}else{assert.match(get('results').innerHTML,/Pasuje do/)}});
+  }
+  api.setMeta({version:'5.90',checkedAt:'2000-01-01T00:00:00Z'});api.updateInfo();
+  check('Stale warning visible',()=>assert.equal(get('freshnessWarning').hidden,false));
+  api.setMeta({version:'5.90',checkedAt:new Date().toISOString()});api.updateInfo();
+  check('Fresh metadata does not warn',()=>assert.equal(get('freshnessWarning').hidden,true));
+  ctx.navigator.onLine=false;api.updateNetworkStatus();
+  check('Offline status uses loaded data',()=>{assert.equal(get('networkStatus').hidden,false);assert.match(get('networkStatus').textContent,/zapisane/)});
+  ctx.navigator.onLine=true;api.updateNetworkStatus();
+  check('Online hides offline status',()=>assert.equal(get('networkStatus').hidden,true));
+  const noteCode=Object.keys(data.notes)[0];let notes=null;
+  const row={querySelector(selector){if(selector===':scope > .body > .notes')return notes&&!notes.removed?notes:null;if(selector==='.body')return {appendChild(node){notes=node}};throw Error('Unexpected selector '+selector)}};
+  const toggle={dataset:{notes:noteCode},attrs:{},getAttribute(k){return this.attrs[k]},setAttribute(k,v){this.attrs[k]=v},closest(){return row}};
