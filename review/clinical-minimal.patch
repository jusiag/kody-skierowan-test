+.search-icon{position:absolute;left:16px;top:19px;width:15px;height:15px;border:2px solid var(--muted);border-radius:50%;pointer-events:none}
+.search-icon::after{content:"";position:absolute;width:7px;height:2px;background:var(--muted);transform:rotate(45deg);right:-5px;bottom:-3px}
+.field .clear{position:absolute;right:6px;top:50%;transform:translateY(-50%);border:0;background:transparent;color:var(--muted);font-size:24px;width:44px;height:44px;border-radius:8px}
+#q::-webkit-search-cancel-button{display:none}
+.section-h{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin:0 0 10px;color:var(--muted);font-size:13px}
+.section-h h2{font-size:14px;color:var(--ink);font-weight:650;margin:0;line-height:1.5}
+.section-h > :last-child{flex-shrink:0}
+.section-h .linkbtn{max-width:180px}
+.list{border:1px solid var(--line);border-radius:var(--radius);background:var(--surface)}
+.row{display:grid;grid-template-columns:1fr 44px;align-items:start;gap:8px 12px;padding:16px;border-top:1px solid var(--line)}
+.row:first-child{border-top:0}
+.code{display:inline-flex;align-items:center;justify-content:center;gap:10px;justify-self:start;min-height:44px;padding:8px 10px;white-space:nowrap;font:650 16px/1.4 var(--font-code);font-variant-numeric:tabular-nums;color:var(--accent);background:var(--code-bg);border:1px solid var(--control-line);border-radius:var(--radius-sm)}
+.copy-icon{position:relative;display:inline-block;width:12px;height:14px;border:1.5px solid currentColor;border-radius:2px;margin:2px 2px 0 0;flex:none}
+.copy-icon::before{content:"";position:absolute;inset:-4px 3px 3px -4px;border-top:1.5px solid currentColor;border-left:1.5px solid currentColor;border-radius:2px}
+.code.copied{background:var(--accent);color:var(--on-accent);border-color:var(--accent)}
+.body{grid-column:1/-1;grid-row:2;min-width:0;display:flex;flex-direction:column;gap:6px}
+.name{font-weight:550;overflow-wrap:anywhere;line-height:1.5}
+mark{background:var(--accent-soft);color:inherit;border-radius:3px;padding:0 1px}
+.path{font-size:13px;color:var(--muted);line-height:1.55;overflow-wrap:anywhere}
+.path button{display:inline;text-align:left;font:inherit;color:inherit;background:none;border:0;padding:2px 0;text-decoration:underline;text-decoration-color:var(--control-line);text-underline-offset:3px}
+.meta{display:flex;flex-wrap:wrap;align-items:center;gap:4px 12px;font-size:13px}
+.meta button{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:6px 0;font:600 13px/1.5 var(--font-body);color:var(--accent);background:none;border:0;text-align:left}
+.meta button::after{content:"+";font-size:18px;font-weight:400}
+.meta button[aria-expanded="true"]::after{content:"−"}
+.tag{font-size:12px;color:var(--muted);background:var(--bg);border:1px solid var(--line);border-radius:4px;padding:2px 6px}
+.star{grid-column:2;grid-row:1;justify-self:end;display:grid;place-items:center;width:44px;height:44px;border:0;border-radius:8px;background:transparent;color:var(--muted);font-size:25px;line-height:1}
+.star.on{color:var(--accent);background:var(--accent-soft)}
+.notes{font-size:14px;color:var(--muted);background:var(--code-bg);border-left:3px solid var(--accent);border-radius:0 6px 6px 0;padding:12px;display:flex;flex-direction:column;gap:8px}
+.notes b{color:var(--ink);font-weight:650}
+.kids{grid-column:1/-1;margin-top:8px;border-left:2px solid var(--line);padding-left:8px}
+.kids .row{padding:12px 0 12px 4px}
+.kids .kids{padding-left:4px}
+.catbtn{display:flex;align-items:center;gap:10px;width:100%;text-align:left;font-weight:600;padding:14px 16px;min-height:56px;border:1px solid var(--line);border-radius:var(--radius);background:var(--surface);color:var(--ink)}
+.catbtn .cnt{margin-left:auto;font-size:13px;font-weight:400;color:var(--muted)}
+.chev{display:inline-block;flex:none;color:var(--accent);width:12px}
+[aria-expanded="true"] > .chev{transform:rotate(90deg)}
+.tree{margin-top:10px}
+.node{border-top:1px solid var(--line)}
+.tree>.node:first-child{border-top:0}
+.nhead{display:flex;align-items:flex-start;flex-wrap:wrap;gap:4px 10px;padding:10px}
+.nhead .code{font-size:14px;min-height:44px}
+.nname{display:flex;gap:8px;align-items:baseline;flex:1 1 140px;min-width:0;min-height:44px;text-align:left;color:var(--ink);background:none;border:0;padding:8px 2px;border-radius:6px}
+.nname .nt{flex:1;min-width:0;overflow-wrap:anywhere}
+.nname .cnt{font-size:12px;color:var(--muted)}
+.nkids{margin-left:8px;border-left:2px solid var(--line);padding-left:4px}
+.nkids .nkids{margin-left:4px;padding-left:2px}
+.nkids>.node,.nkids>.row{border-top:1px dashed var(--line)}
+.nkids>:first-child{border-top:0}
+.nkids>.row{padding:12px 8px}
+.btn{display:inline-flex;align-items:center;justify-content:center;min-height:44px;gap:8px;padding:10px 16px;border:1px solid var(--accent);border-radius:8px;font-size:14px;font-weight:600;background:var(--accent);color:var(--on-accent);text-decoration:none}
+.btn.ghost{background:var(--surface);color:var(--accent)}
+.btn[disabled]{opacity:.55;cursor:default}
+.linkbtn{font:600 13px/1.5 var(--font-body);color:var(--accent);background:none;border:0;min-height:44px;padding:6px 0;text-decoration:underline;text-underline-offset:3px}
+.empty{padding:24px 20px;color:var(--muted);line-height:1.65}
+.hint{font-size:14px;color:var(--muted)}
+#loadMsg{margin:0}
+.notice{padding:12px 14px;border:1px solid var(--line);border-radius:8px;background:var(--surface);font-size:14px;overflow-wrap:anywhere}
+.notice.warning{background:var(--warn-bg);color:var(--warn-ink);border-color:var(--warn-line)}
+.notice.error{border-color:var(--err);color:var(--err)}
+.notices{display:flex;flex-direction:column;gap:8px}
+.notices:has(> :not([hidden])){margin-top:-12px}
+.notices:not(:has(> :not([hidden]))){display:none}
+.resort-heading{margin-top:24px}
+.resban{margin:0 0 12px;padding:14px 16px;border:1px solid var(--line);border-left:3px solid var(--accent);border-radius:var(--radius);background:var(--surface);font-size:14px;line-height:1.65}
+.resban b{font-weight:650}
+.resnote{margin:14px 0;font-size:13px;color:var(--muted);line-height:1.7}
+.resnote a,.resban a{color:var(--accent)}
+.rrow{grid-template-columns:1fr}
+.grp{padding:12px 16px;color:var(--muted);font-size:13px;font-weight:650;background:var(--code-bg);border-top:1px solid var(--line)}
+.grp:first-child{border-top:0;border-radius:var(--radius) var(--radius) 0 0}
+.tobar{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;padding:16px}
+footer{font-size:13px;line-height:1.7;color:var(--muted);border-top:1px solid var(--line);padding-top:24px;display:flex;flex-direction:column;gap:12px}
+.src{display:grid;gap:14px}
+.src>h2{font-size:14px;color:var(--ink);margin:0;font-weight:650}
+.src p{margin:0;overflow-wrap:anywhere}
+.src strong{font-weight:650;color:var(--ink)}
+.src #checkInfo{padding-left:12px;border-left:2px solid var(--line)}
+.src #checkInfo:empty{display:none}
+.legal{border-top:1px solid var(--line);padding-top:14px}
+.install-info{border-top:1px solid var(--line);padding-top:12px}
+.toast{position:fixed;left:50%;bottom:calc(20px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);max-width:calc(100% - 32px);width:max-content;background:var(--ink);color:var(--bg);padding:12px 18px;border-radius:10px;font-size:14px;font-weight:600;z-index:20;pointer-events:none}
+.toast:empty{display:none}
+.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
+.skip-link{position:fixed;left:16px;top:-100px;z-index:30;background:var(--surface);padding:12px}
+.skip-link:focus{top:12px}
+@media(hover:hover){.code:not(.copied):hover{background:var(--accent-soft);border-color:var(--accent)}.star:hover{background:var(--accent-soft);color:var(--accent)}.catbtn:hover{border-color:var(--accent)}.path button:hover{color:var(--accent)}}
+@media(min-width:600px){
+  .top{padding-top:32px}.wrap{gap:24px}
+  .row{grid-template-columns:auto minmax(0,1fr) 44px;gap:12px 16px;padding:16px 18px}
+  .body{grid-column:2;grid-row:1}.star{grid-column:3}
+  .rrow{grid-template-columns:auto minmax(0,1fr)}
+  .code{min-width:105px}.nhead .code{min-width:80px}
+}
+@media(max-width:359px){body{padding-inline:12px}.row{padding:12px}.field input{font-size:16px}.section-h{flex-wrap:wrap}.section-h>:last-child{flex-shrink:1}.nhead{padding:8px}}
+@media(max-height:480px){.searchbar{position:relative;top:auto}}
+@media(prefers-reduced-motion:no-preference){.code,.star{transition:background-color .12s,color .12s}}
+@media(forced-colors:active){.code,.catbtn,.field input{border:1px solid ButtonText}.star.on{outline:2px solid Highlight}.copy-icon{forced-color-adjust:auto}mark{outline:1px solid Highlight}}
+.tobar:empty{display:none}
